{
  "name": "Article Publishing Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "/webhook/telegram",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "telegram-trigger-node",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "documentId": "your_google_sheet_id_here",
        "sheetName": "Sheet1",
        "options": {}
      },
      "id": "get-all-articles-node",
      "name": "Get All Articles from Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        520,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "google_sheets_cred_id",
          "name": "Google Sheets OAuth2 account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Извлечение заголовка и описания из входящего сообщения\nconst messageText = $input.first().json.text || $input.first().json.message?.text;\n\n// Предполагаем формат: Заголовок: ...\nОписание: ...\nconst lines = messageText.split('\n');\nlet title = '';\nlet description = '';\n\nfor (const line of lines) {\n  if (line.startsWith('Заголовок:') || line.startsWith('Заголовок ')) {\n    title = line.substring(line.indexOf(':') + 1).trim();\n  } else if (line.startsWith('Описание:') || line.startsWith('Описание ')) {\n    description = line.substring(line.indexOf(':') + 1).trim();\n  }\n}\n\n// Проверяем, есть ли дубликаты в полученных данных из Google Sheets\nconst existingArticles = $input.all().slice(1); // Пропускаем первый элемент, так как он содержит данные из вебхука\nlet isDuplicate = false;\n\nfor (const article of existingArticles) {\n  const existingTitle = article.json.Title || article.json.title || '';\n  if (existingTitle.toLowerCase().includes(title.toLowerCase()) || \n      title.toLowerCase().includes(existingTitle.toLowerCase())) {\n    isDuplicate = true;\n    break;\n  }\n}\n\n// Возвращаем результат с проверкой дубликата\nreturn [{\n  json: {\n    title: title,\n    description: description,\n    isDuplicate: isDuplicate,\n    originalMessage: messageText\n  }\n}];"
      },
      "id": "check-duplicate-node",
      "name": "Check Duplicate Article",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "id": "condition-1",
              "leftValue": "={{ $('Check Duplicate Article').item.json.isDuplicate }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equal"
              }
            }
          ],
          "combineOperation": "and"
        }
      },
      "id": "duplicate-check-condition-node",
      "name": "Continue if Not Duplicate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1040,
        300
      ]
    },
    {
      "parameters": {
        "model": "gemini-pro",
        "prompt": "={{ $('Check Duplicate Article').item.json.title + '\n' + $('Check Duplicate Article').item.json.description }}",
        "options": {}
      },
      "id": "generate-article-gemini-node",
      "name": "Generate Article with Gemini",
      "type": "n8n-nodes-base.googleGemini",
      "typeVersion": 1,
