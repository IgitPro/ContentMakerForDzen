            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "body": "={\"model\": \"openai/dall-e-3\", \"prompt\": \"{{ $('Prepare Image Prompt').item.json.imagePrompt }}\", \"n\": 1, \"size\": \"1024x1024\"}",
        "options": {}
      },
      "id": "generate-image-openrouter-node",
